# ===========================================
# REAL ESTATE PROPERTY OS - Environment Config
# ===========================================

# Server
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000

# MongoDB
MONGODB_URI=mongodb://admin:password@localhost:27017/realestate?authSource=admin

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Initial Admin (used for first-time bootstrap only)
INITIAL_ADMIN_EMAIL=admin@company.com
INITIAL_ADMIN_PASSWORD=ChangeThisPassword123!

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=realestate-media
R2_PUBLIC_URL=

# Resend (Email)
RESEND_API_KEY=
MAIL_FROM=noreply@yourdomain.com

# WhatsApp Business Platform
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Currency Exchange Rate API
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4

# Google Gemini AI
GEMINI_API_KEY=

# Google Maps
GOOGLE_MAPS_API_KEY=

# Sentry (Error Monitoring)
SENTRY_DSN=

# Frontend URLs (for CORS)
PUBLIC_WEBSITE_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
