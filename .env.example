
# ESTATEELITE LUXURY REAL ESTATE - PRODUCTION ENVIRONMENT CONFIGURATION
# 1. CORE SERVER & ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000
API_URL=https://api.yourdomain.com

# ------------------------------------------------------------------------------
# 2. MONGODB ATLAS DATABASE (Primary Data Store)
# How to get:
# 1. Go to https://www.mongodb.com/cloud/atlas and create a free or dedicated cluster.
# 2. Under Database Access, create a database user (username & secure password).
# 3. Under Network Access, whitelist IP 0.0.0.0/0 (or your server IP).
# 4. Click Connect -> Drivers -> Node.js, and copy the connection string.
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/realestate?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. REDIS CACHE & BACKGROUND QUEUES (Optional for single-instance, required for distributed)
# How to get:
# 1. Local/VPS: sudo apt install redis-server (redis://localhost:6379)
# 2. Managed: https://upstash.com/ (Free Serverless Redis) or Redis Cloud
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 4. JWT SECURITY & CRYPTOGRAPHY (CRITICAL)
# How to generate:
# Run in your terminal: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ------------------------------------------------------------------------------
JWT_SECRET=generate_64_byte_random_hex_string_here
JWT_REFRESH_SECRET=generate_second_64_byte_random_hex_string_here
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ------------------------------------------------------------------------------
# 5. INITIAL MASTER ADMIN (For initial system bootstrap)
# ------------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL=admin@estateelite.com
INITIAL_ADMIN_PASSWORD=SetAStrongPasswordHere2026!

# ------------------------------------------------------------------------------
# 6. RESEND EMAIL SERVICE (Client OTPs, Booking & Viewing Confirmations)
# How to get:
# 1. Go to https://resend.com and create a free account (3,000 emails/month free).
# 2. Go to API Keys -> Create API Key -> Copy key.
# 3. Under Domains, add and verify your custom sending domain (e.g. yourdomain.com).
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM=EstateElite Advisory <advisory@yourdomain.com>

# ------------------------------------------------------------------------------
# 7. GOOGLE GEMINI AI (Advisory Chatbot & Property Insights)
# How to get:
# 1. Go to https://aistudio.google.com/app/apikey (Google AI Studio).
# 2. Click "Create API Key" (Free tier available with high rate limits).
# 3. Copy the key.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 8. CLOUDFLARE R2 OR AWS S3 (High-Resolution Property Photography & Brochures)
# How to get (Cloudflare R2 - zero egress fees):
# 1. Go to https://dash.cloudflare.com/ -> R2 Object Storage -> Create Bucket.
# 2. Under R2 Overview -> "Manage R2 API Tokens" -> Create Token (Object Read & Write).
# 3. Copy Account ID, Access Key ID, and Secret Access Key.
# 4. Under Bucket Settings -> Public Access -> Connect custom domain or enable r2.dev subdomain.
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET_NAME=estateelite-media
R2_PUBLIC_URL=https://media.yourdomain.com

# ------------------------------------------------------------------------------
# 9. META WHATSAPP BUSINESS CLOUD API (Official WhatsApp Lead Notifications)
# How to get:
# 1. Go to https://developers.facebook.com/ -> Create App -> Business -> WhatsApp.
# 2. In the WhatsApp Getting Started page, copy your Phone Number ID and Temporary Access Token.
# 3. For production, generate a permanent System User Token under Meta Business Manager.
# ------------------------------------------------------------------------------
WHATSAPP_TOKEN=EAAGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=100xxxxxxxxxxxx
WHATSAPP_BUSINESS_ACCOUNT_ID=100xxxxxxxxxxxx
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_secret_verification_string
WHATSAPP_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 10. REAL-TIME CURRENCY EXCHANGE RATE API (Multi-Currency Conversion)
# How to get:
# 1. Go to https://www.exchangerate-api.com/ (Free tier: 1,500 requests/month).
# 2. Sign up and copy your API Key.
# ------------------------------------------------------------------------------
EXCHANGE_RATE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
EXCHANGE_RATE_API_URL=https://v6.exchangerate-api.com/v6

# ------------------------------------------------------------------------------
# 11. GOOGLE MAPS API (Interactive Property Map Pins & Street Navigation)
# How to get:
# 1. Go to https://console.cloud.google.com/ -> APIs & Services -> Credentials.
# 2. Enable "Maps JavaScript API" and "Places API".
# 3. Create Credentials -> API Key -> Restrict key to your HTTP referrers.
# ------------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 12. SENTRY (Application Error & Performance Monitoring - Optional)
# How to get:
# 1. Go to https://sentry.io -> Create Project (Node.js / Express).
# 2. Copy the DSN URL.
# ------------------------------------------------------------------------------
SENTRY_DSN=

# ------------------------------------------------------------------------------
# 13. DOMAINS & CORS WHITELIST (Production Origins)
# ------------------------------------------------------------------------------
PUBLIC_WEBSITE_URL=https://estateelite.com
ADMIN_URL=https://admin.estateelite.com

# ------------------------------------------------------------------------------
# 14. AGENCY HEADQUARTERS & CONTACT DEFAULTS (Overridable via Admin Settings)
# ------------------------------------------------------------------------------
AGENCY_NAME=EstateElite Luxury Real Estate
AGENCY_PHONE=+353 1 234 5678
AGENCY_WHATSAPP=+353891234567
AGENCY_EMAIL=advisory@estateelite.com
AGENCY_ADDRESS=48 Grand Canal Square, Docklands, Dublin 2, Ireland
AGENCY_OFFICE_HOURS=Mon - Sat: 9:00 AM - 7:00 PM GMT
AGENCY_VIDEO_URL=https://meet.google.com/new

